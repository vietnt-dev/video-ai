# OpenAI
OPENAI_API_KEY=sk-...

# OpenAI Model:
# gpt-4o       → chất lượng cao nhất, ~$0.008/video
# gpt-4o-mini  → rẻ hơn 15x, ~$0.0005/video, vẫn rất tốt (KHUYẾN NGHỊ khi mới bắt đầu)
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (MIỄN PHÍ — KHUYẾN NGHỊ) ────────────────────────
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
# Free tier: 1500 request/ngày cho Gemini Flash, Imagen 3 miễn phí
GEMINI_API_KEY=

# AI Provider: "gemini" (free) hoặc "openai" (trả phí)
# Nếu gemini key có → dùng Gemini, nếu không → tự động fallback OpenAI
AI_PROVIDER=gemini

# Gemini models (không cần đổi)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# ElevenLabs (optional - nếu không có sẽ dùng edge-tts miễn phí)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels (stock video miễn phí - lấy tại pexels.com/api)
PEXELS_API_KEY=

# ── AI Image Generation ────────────────────────────────────────────
# Replicate (Stable Diffusion XL) - lấy tại replicate.com
# Rẻ hơn DALL-E 3 ~10x (~$0.003/ảnh)
REPLICATE_API_TOKEN=

# Media source strategy:
# "pexels"      → chỉ dùng Pexels (miễn phí, cần API key)
# "ai_image"    → AI image + Ken Burns, bám nội dung hơn (Gemini/OpenAI/Replicate)
# "ai_image_sd" → Stable Diffusion (cần Replicate key, $0.003/ảnh)
# "hybrid"      → Pexels trước, fallback AI image
MEDIA_SOURCE=hybrid

# Redis
REDIS_URL=redis://redis:6379/0

# App
OUTPUT_DIR=./outputs
ASSETS_DIR=./assets
MAX_VIDEO_DURATION=60

# TTS Engine: "elevenlabs" hoặc "edge-tts" (miễn phí, giọng Việt tự nhiên)
TTS_ENGINE=edge-tts

# edge-tts voice cho tiếng Việt:
# vi-VN-HoaiMyNeural  → giọng nữ miền Nam (khuyến nghị)
# vi-VN-NamMinhNeural → giọng nam miền Nam
EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_VI_MALE=vi-VN-NamMinhNeural
EDGE_TTS_VOICE_EN=en-US-AriaNeural
EDGE_TTS_VOICE_EN_MALE=en-US-GuyNeural
EDGE_TTS_RATE=+25%
EDGE_TTS_PITCH=+0Hz

# ── YouTube Upload (Google Cloud Console) ──────────────────────────
# Hướng dẫn lấy credentials: xem YOUTUBE_SETUP.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
